# Copy to .env.local for local development. Never commit real values.
# Both values are safe to ship to the browser: the publishable key only allows what
# the database's access rules allow. Do NOT put a secret/service-role key, a database
# password or a Google client secret in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Local test stack only (npm run db:start). Shows an email sign-in for automated tests.
# Leave unset in every deployed environment.
# VITE_ENABLE_TEST_LOGIN=true
